# ---- security ----
# The camera sends this with every frame. Use a long random string and put the same value in the camera setup page.
DEVICE_KEY=change-me-to-something-long
# Used by the MCP server (EYE_TOKEN) to read frames. Defaults to DEVICE_KEY.
GATEWAY_TOKEN=

# ---- how the AI runs ----
# cascade:     works with ANY LLM. Listens, attaches the newest camera frame to your question, answers by voice.
# gemini_live: Google's live model gets your voice + 1 frame/s continuously and talks back natively.
MODE=cascade
# Show the camera view on the phone page (on/off)
PHONE_VIDEO=on
# en-IN, hi-IN, or auto
LANGUAGE=hi-IN

# ---- the brain (cascade mode) ----
# openai | anthropic | google | groq | openrouter | sarvam | glm | kimi | together | ollama | compatible
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# only for LLM_PROVIDER=compatible (any OpenAI-compatible endpoint)
LLM_BASE_URL=

# ---- ears and voice (cascade mode) ----
# sarvam | openai | groq
STT_PROVIDER=sarvam
STT_MODEL=
# sarvam | openai
TTS_PROVIDER=sarvam
TTS_MODEL=
TTS_VOICE=

# ---- provider keys (fill only the ones you use) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SARVAM_API_KEY=

# gemini_live mode only (optional, defaults to Pipecat's current Gemini Live model)
GEMINI_LIVE_MODEL=
